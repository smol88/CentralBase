
Функция PingПроверитьСоединение(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки("OK");
	Возврат Ответ;
КонецФункции

Функция ВыполнитьОбмен(Запрос)
	
	ИдентификаторКлиента = Запрос.Заголовки.Получить("X-mobileID");
	Узел = ПланыОбмена.ОбменСМобильнымПриложением.НайтиПоКоду(ИдентификаторКлиента);
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		УзелОбъект = ПланыОбмена.ОбменСМобильнымПриложением.СоздатьУзел();
		УзелОбъект.Наименование = ИдентификаторКлиента;
		УзелОбъект.Код = ИдентификаторКлиента;
		УзелОбъект.Пользователь = Пользователи.ТекущийПользователь();
		УзелОбъект.Записать();
		Узел = УзелОбъект.Ссылка;
		ПервичнаяРегистрация(Узел);
	КонецЕсли;
	
	ОтправленныеОбъекты = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Смол_ДоставкаИзменения.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Смол_Доставка.Изменения КАК Смол_ДоставкаИзменения
	               |ГДЕ
	               |	Смол_ДоставкаИзменения.Узел = &Узел";
	
	Запрос.УстановитьПараметр("Узел", Узел); 
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОтправленныеОбъекты.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	ТелоОтвета = ЗаписатьЗначениеJSON(ОтправленныеОбъекты.Количество());
	
	Если ЗначениеЗаполнено(ОтправленныеОбъекты) Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, ОтправленныеОбъекты);
	КонецЕсли;
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type","application/json");
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	Возврат Ответ;
	
КонецФункции

Процедура ПервичнаяРегистрация(Узел)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Смол_Доставка.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Смол_Доставка КАК Смол_Доставка
	               |ГДЕ
	               |	Смол_Доставка.Ответственный = &Ответственный";
	
	Запрос.УстановитьПараметр("Ответственный", Пользователи.ТекущийПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОбъектыДляРегистрации = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		ОбъектыДляРегистрации.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОбъектыДляРегистрации) Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, ОбъектыДляРегистрации);
	КонецЕсли;
	
КонецПроцедуры

